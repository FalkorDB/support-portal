# Zendesk Configuration
# Your Zendesk subdomain (e.g., if your URL is https://mycompany.zendesk.com, use "mycompany")
ZENDESK_SUBDOMAIN=your-subdomain

# Admin email for API authentication
ZENDESK_EMAIL=your-email@example.com

# API token from Zendesk Admin Center → Apps and integrations → APIs → Zendesk API → Settings
ZENDESK_API_TOKEN=your_api_token_here

# Zendesk OAuth Configuration (for "Login with Zendesk" button)
# Create an OAuth client at: Zendesk Admin Center → Apps and integrations → APIs → OAuth Clients
# Redirect URL: http://localhost:3000/api/auth/callback/zendesk (and your production URL)
ZENDESK_OAUTH_CLIENT_ID=your_zendesk_oauth_client_id
ZENDESK_OAUTH_CLIENT_SECRET=your_zendesk_oauth_client_secret

# Session Secret (generate a random string for production)
SESSION_SECRET=change_this_to_a_random_secret_key_in_production

# NextAuth Configuration
# You can use SESSION_SECRET for AUTH_SECRET, or generate a separate one
AUTH_SECRET=change_this_to_a_random_secret_key_in_production

# For production, set AUTH_URL to your production domain:
# AUTH_URL=http://localhost:3000
AUTH_URL=https://mydomain.com
